{
  "name": "react-sheet-uploader",
  "version": "1.1.0",
  "description": "Open-source, embeddable spreadsheet importer for React. Drop-in compatible with the Dromo uploader API: same fields schema, settings, row/bulk/column/step hooks, and results shape.",
  "license": "MIT",
  "author": "BilalJaved15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BilalJaved15/react-sheet-uploader.git"
  },
  "homepage": "https://github.com/BilalJaved15/react-sheet-uploader#readme",
  "bugs": {
    "url": "https://github.com/BilalJaved15/react-sheet-uploader/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "csv",
    "xlsx",
    "excel",
    "spreadsheet",
    "importer",
    "uploader",
    "dromo",
    "flatfile",
    "data-import"
  ],
  "scripts": {
    "dev": "vite --mode demo",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "read-excel-file": "^9.3.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fflate": "^0.8.3",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "terser": "^5.49.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "yarn@4.18.0"
}
